# Exemplo de credenciais - copie para config/database.ini e preencha com valores reais
# config/database.ini está no .gitignore e não deve ser commitado

[dashboard]
host = "SEU_HOST"
user = "SEU_USUARIO"
pass = "SUA_SENHA"
name = "dashboard"
charset = "utf8"

[intersig]
host = "localhost"
user = "root"
pass = "SUA_SENHA"
name = "intersig"
charset = "utf8"

# Nome exibido no sistema (títulos, cabeçalhos e relatórios)
[empresa]
nome = "Nome da Empresa"

